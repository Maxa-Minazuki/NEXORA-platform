# Copy to .env and change the passwords. .env is git-ignored - never commit real secrets.

# --- Database (used by docker compose and by the local "dev" profile)
DB_NAME=nexora
DB_USERNAME=nexora
DB_PASSWORD=change_me_db_password
MYSQL_ROOT_PASSWORD=change_me_root_password
# Host port of the compose MySQL (the dev profile below expects 3307 for the stand-alone dev container)
MYSQL_HOST_PORT=3308

# --- Frontend (nginx) port on the host
FRONTEND_PORT=8088

# --- Business configuration (read by the PlatformSettings singleton)
BUSINESS_TIMEZONE=Asia/Almaty
# minimum-level | safety-buffer
LOW_STOCK_POLICY=minimum-level
BOOKING_HOLD_MINUTES=15

# --- Security: set to true when serving over HTTPS
COOKIE_SECURE=false
# Restore the five demo accounts (password, active flag, role) on every start. Never deletes data.
DEMO_ACCOUNTS_SYNC=true

# --- Optional e-mail channel. Leave EMAIL_ENABLED=false for the demo: e-mails are then logged as
# SKIPPED ("SMTP not configured") in the delivery log - never reported as sent.
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@nexora.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
